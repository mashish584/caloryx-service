// CaloryX — onboarding data model.
// PRD §7. Extended with Clerk identity, guest claiming, and server-side engine config (§10).

generator client {
  provider             = "prisma-client-py"
  interface            = "sync"
  recursive_type_depth = 5
  // pg_trgm backs Food's name search index - declared here rather than in
  // raw SQL so `prisma db push` doesn't see the index as drift and drop it.
  // vector (pgvector) backs the semantic half of food resolution (§7.2,
  // §12.6) - Chunk 9a creates the columns; nothing reads them until 9b.
  previewFeatures      = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pg_trgm, vector]
}

enum SexAtBirth {
  MALE
  FEMALE
  UNSPECIFIED // defensive-only value (§6.4); onboarding v7 never writes it
}

enum Goal {
  LOSE
  MAINTAIN
  GAIN
}

enum ActivityLevel {
  SEDENTARY
  LIGHT
  MODERATE
  VERY
  EXTREME
}

/// DEPRECATED - superseded by WeightUnit + HeightUnit, which can express the
/// mixed choices (kg + ft/in, lb + cm) a single system cannot. Kept only until
/// `backfill_unit_preferences` has run everywhere; drop with the column.
enum UnitSystem {
  METRIC
  IMPERIAL
}

/// Display units (§5.2). Values are always stored metric; these record only how
/// the client renders them. Weight covers current and target weight alike.
enum WeightUnit {
  KG
  LB
}

enum HeightUnit {
  CM
  FT_IN
}

enum AuthProvider {
  GUEST
  CLERK
}

model User {
  id           String       @id @default(cuid())
  // Clerk owns Google / Apple / any future provider on the client. We store the
  // stable Clerk user id; the underlying provider is recorded for analytics only.
  clerkUserId  String?      @unique
  authProvider AuthProvider @default(GUEST)
  // Which social provider Clerk used ("oauth_google", "oauth_apple", ...). Nullable
  // for guests. Apple private-relay addresses land in `email` unchanged.
  externalProvider String?
  email        String?
  isGuest      Boolean      @default(true)
  // Set when a guest record is merged into a Clerk identity (§5.1 claiming).
  claimedAt    DateTime?
  claimedFrom  String?      @unique
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  lastSeenAt   DateTime     @default(now())
  profile      Profile?
  loggedMeals  LoggedMeal[]
  chatSessions ChatSession[]
  mealDrafts   MealDraft[]
  chatMessages ChatMessage[]
  parseEvents  ParseEvent[]
  servingPreferences UserServingPreference[]
  aiQuotaCounter     AiQuotaCounter?

  @@index([isGuest, createdAt])
}

model Profile {
  id             String        @id @default(cuid())
  userId         String        @unique
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  sexAtBirth     SexAtBirth // onboarding v7 writes MALE or FEMALE
  /// The user's date of birth (§9). Age is derived from this on every read and
  /// never stored, so it advances with the calendar instead of freezing at
  /// signup. A pure date: only ever used for year arithmetic.
  dateOfBirth    DateTime?     @db.Date
  // DEPRECATED - read only by `backfill_date_of_birth`; drop once it has run.
  age            Int
  weightKg       Float // stored metric; imperial is a display concern (§5.2)
  heightCm       Float
  targetWeightKg Float?
  goal           Goal
  activityLevel  ActivityLevel
  weightUnit     WeightUnit    @default(KG)
  heightUnit     HeightUnit    @default(CM)
  // DEPRECATED - read only by `backfill_unit_preferences`; drop once it has run.
  preferredUnits UnitSystem    @default(METRIC)
  onboardedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  plan           Plan?
}

model Plan {
  id           String   @id @default(cuid())
  profileId    String   @unique
  profile      Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  caloriesKcal Int
  proteinG     Int
  carbsG       Int
  fatG         Int
  fiberG       Int // informational; never part of the energy total (§5.5)
  bmr          Float
  tdee         Float
  clamped      Boolean  @default(false)
  isEstimate   Boolean  @default(false) // true only via the §6.4 defensive fallback
  // Rationale derives from the *effective* adjustment, which differs from the
  // configured one whenever the safety floor clamps the target (§6.2).
  adjustmentKcal Int
  weeklyChangeKg Float
  // The §6.2 floor that produced this target and the goal adjustment it overrode,
  // so a resumed plan explains itself without re-deriving from a config that may
  // since have been retuned. Nullable only for rows written before these columns
  // existed; `manage.py backfill_plan_rationale` clears them.
  safetyFloorKcal         Int?
  requestedAdjustmentKcal Int?
  // Which config produced these numbers, so a plan stays explainable after a retune.
  engineConfigId String?
  engineConfig   EngineConfig? @relation(fields: [engineConfigId], references: [id])
  computedAt     DateTime      @default(now())
}

/// Server-configurable engine constants (§5.3, §5.4, §6.3, §10). Exactly one row
/// should have isActive = true; code falls back to compiled defaults if none does.
model EngineConfig {
  id       String  @id @default(cuid())
  name     String  @unique
  isActive Boolean @default(false)

  // Goal adjustments (kcal)
  loseAdjustmentKcal Int @default(-400)
  gainAdjustmentKcal Int @default(400)

  /// Half-width of the MAINTAIN band, kg. A target within this of the current
  /// weight derives MAINTAIN; outside it the sign of the difference picks LOSE
  /// or GAIN. The goal is derived rather than asked for (§5.3), so this is the
  /// threshold that decides which adjustment above a user gets.
  maintainBandKg Float @default(1.0)

  // Activity multipliers
  sedentaryMultiplier Float @default(1.2)
  lightMultiplier     Float @default(1.375)
  moderateMultiplier  Float @default(1.55)
  veryMultiplier      Float @default(1.725)
  extremeMultiplier   Float @default(1.9)

  // Macro ratios
  proteinPerKg      Float @default(1.8)
  fatPct            Float @default(0.25)
  fiberGPer1000Kcal Float @default(15.0)

  // Safety floors (§6.2)
  floorMaleKcal        Int @default(1500)
  floorFemaleKcal      Int @default(1200)
  floorUnspecifiedKcal Int @default(1500)

  // Rounding + rationale
  targetRoundingKcal Int   @default(10)
  kcalPerKgBodyMass  Float @default(7700.0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  plans     Plan[]

  @@index([isActive])
}

// --- Meal logging (AI Meal Assistant PRD §6, §8) ---------------------------
//
// Chunk 1 of the roadmap: the deterministic foundation every later chunk
// (chat drafts, AI parsing, composite foods, ...) builds on. No chat, no AI -
// just a Food catalog and the ability to log a fully-quantified meal against
// it, with the same nutrition math every later tier will call into.

enum FoodSource {
  USDA
  OPEN_FOOD_FACTS
  CALORYX_CURATED
  // Indian Nutrient Databank (Anuvaad, derived from ICMR-NIN IFCT 2017) -
  // its own value, not CALORYX_CURATED, so the source sheet (§5.2.1) credits
  // the right database.
  INDB
}

/// Raw vs. cooked - the single largest accuracy risk in text-based logging
/// (§8: rice roughly triples in mass when cooked). UNSPECIFIED means the
/// distinction was never captured, not that the food has none.
enum FoodState {
  RAW
  COOKED
  UNSPECIFIED
}

enum ServingUnitType {
  CONTINUOUS
  COUNTABLE
  HOUSEHOLD
}

enum MealSlot {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

/// Distinguishes how a `LoggedMeal` was created (§6 "parity with the Meals
/// surface") without implying a different record shape. CHAT_AI is unused
/// until the chat pipeline (Chunk 2+) starts writing here.
enum LoggedMealSource {
  MANUAL
  CHAT_AI
}

/// Food catalog (§8). Nutrient columns are per 100g, on `defaultState` basis -
/// e.g. rice defaults to COOKED, so its vector describes cooked rice, and a
/// raw-stated quantity is converted via `rawToCookedYield` before lookup
/// (see nutrition.calculator.apply_yield).
model Food {
  id     String     @id @default(cuid())
  name   String
  source FoodSource
  // External id/name at the source - USDA FDC id, Open Food Facts barcode,
  // INDB food code, or a curation note. Nullable for CALORYX_CURATED entries
  // with no upstream ref.
  sourceRef        String?
  // Open Food Facts only - generic sources (USDA/INDB/curated) have no brand.
  brand            String?
  defaultState     FoodState @default(UNSPECIFIED)
  // Grams-cooked-per-gram-raw. Null when the food has no meaningful raw/cooked
  // distinction (a banana) or the factor isn't catalogued yet - logging this
  // food in the non-default state then fails validation rather than guessing.
  rawToCookedYield Float?

  caloriesKcalPer100g Float
  proteinGPer100g     Float
  carbsGPer100g       Float
  fatGPer100g         Float
  // Missing != zero (§8): null means unknown and renders as "-"; it must never
  // be coerced to 0, or a partial macro sum silently understates.
  fiberGPer100g        Float?
  sugarGPer100g        Float?
  saturatedFatGPer100g Float?
  sodiumMgPer100g      Float?
  cholesterolMgPer100g Float?

  // Quantity-resolution ladder, steps 3-4 (AI Meal Assistant PRD §5.1.1a). Both
  // nullable - missing is a real state ("no serving data for this food yet"),
  // not zero, so the ladder falls through to the next step rather than
  // assuming a bogus amount. `defaultServingGrams` is the food's own
  // canonical/USDA/package serving (step 3); `category` drives the flat
  // category fallback (step 4, `nutrition.units.CATEGORY_FALLBACK_GRAMS`)
  // when even that isn't catalogued.
  defaultServingGrams Float?
  category            FoodCategory?

  // Semantic half of §7.2's match score ("lexical (trigram) + semantic
  // (embedding) similarity") and of §7.6's composite matching. Nullable, and
  // a null is a real state - "not embedded yet", never a zero vector, which
  // would sit at a fixed cosine distance from every query and match
  // arbitrarily. Resolution falls back to trigram-only for a null, the same
  // posture `defaultServingGrams`/`category` take in the §5.1.1a ladder.
  //
  // prisma-client-py has no vector type, so this column is invisible to the
  // generated client: every read and write goes through `query_raw`/
  // `execute_raw` in meals.repository, the pattern `_SEARCH_SQL` already set.
  // `db push` still creates and keeps the column.
  embedding Unsupported("vector(1536)")?
  // Which model produced `embedding`, so a model swap is detectable per-row
  // and `backfill_food_embeddings` can re-embed only what's stale instead of
  // truncating the column and losing every vector at once.
  embeddingModel String?
  embeddedAt     DateTime?

  servingUnits             FoodServingUnit[]
  loggedMealItems          LoggedMealItem[]
  mealDraftItems           MealDraftItem[]
  compositeFoodComponents  CompositeFoodComponent[]
  servingPreferences       UserServingPreference[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Idempotent re-ingest (`manage.py ingest_foods`). Curated rows with a null
  // sourceRef never collide - Postgres treats every NULL as distinct.
  @@unique([source, sourceRef])
  @@index([name])
  // Trigram candidate retrieval for free-text search (meals.repository
  // .search_foods) - serves both `ILIKE '%q%'` and `q <% name`.
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "Food_name_trgm_idx")
  // NOTE: the pgvector ANN index is NOT declared here. Prisma's `type:`
  // supports Hash/Gist/Gin/SpGist/Brin - there is no Hnsw - so it has to be
  // raw SQL: `manage.py ensure_vector_index`. Unlike the trigram index
  // above, that means `prisma db push` can see it as drift and drop it;
  // re-run the command after a push (it is idempotent).
}

/// Ladder step 4's fallback bucket (§5.1.1a) - a coarse default for a food with
/// no `defaultServingGrams` yet. Grams per category live in
/// `nutrition.units.CATEGORY_FALLBACK_GRAMS`, not here - this enum is only the
/// classification; the numbers are pure/dependency-free like the rest of
/// `nutrition`.
enum FoodCategory {
  GRAIN
  PROTEIN
  VEGETABLE
  DRESSING
  OIL
}

/// Estimated-dish handling for an uncurated composite (§7.6.1, Chunk 5b) - a
/// closed, curated starter set. Adding a category is a curation change (new
/// enum value + a seeded DishCategoryProfile row), same posture as
/// CompositeFood.
enum DishCategory {
  SPICED_CURRY
  FRIED_SNACK
  CREAMY_PASTA
  CLEAR_SOUP
  GRAIN_BOWL
}

/// Curated per-100g calorie band per dish category (§7.6.1) - what makes an
/// "estimated" number deterministic instead of model-authored. The model
/// supplies only a category + serving size; this profile supplies the
/// number. Only calories get a range - macros are null for an estimated dish
/// (§9's MealDraftItem field list has no macro-range fields), not guessed.
model DishCategoryProfile {
  id                     String       @id @default(cuid())
  category               DishCategory @unique
  caloriesKcalP25Per100g Float
  caloriesKcalP75Per100g Float
  // Forward-declared for §12.7's future cache-key versioning, same pattern
  // as CompositeFood.catalogVersion - unused as a cache key until Chunk 8,
  // but already carried on every MealDraftItem.profileVersion it produces.
  catalogVersion Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Global, curator-bumped catalog version (§12.3, §12.7, Chunk 8a) - one row,
// id="global". Food/CompositeFood/DishCategoryProfile are all edited by hand
// (management commands / direct DB access, no admin UI or live curation flow
// exists), so there is no way to auto-detect "the catalog changed" - this
// gives curators a real, bumpable number instead (via `bump_catalog_version`)
// rather than inventing an automatic change-detector this codebase has no
// infrastructure to support. Read by `LoggedMeal.catalogVersion` at confirm
// time and folded into the T0/L2 cache key (§12.7) - unrelated to
// `DishCategoryProfile.catalogVersion`/`CompositeFood.catalogVersion` above,
// which are each their own still-forward-declared, per-entity concept.
model CatalogVersion {
  id        String   @id @default("global")
  version   Int      @default(1)
  updatedAt DateTime @updatedAt
}

/// Household/countable measures, defined per food (§8) - a cup of rice and a
/// cup of spinach are not the same mass. `g`/`kg` are universal and never
/// stored here; see nutrition.units.resolve_grams.
model FoodServingUnit {
  id     String @id @default(cuid())
  food   Food   @relation(fields: [foodId], references: [id], onDelete: Cascade)
  foodId String
  unit   String // "katori", "cup", "roti", "piece"...
  grams  Float  // grams per one `unit`, as-served
  type   ServingUnitType

  @@unique([foodId, unit])
}

/// A logged meal (§6). Whatever surface creates it (this chunk's direct entry,
/// or a chat draft later), it lands here as the same record - `source` is the
/// only thing that varies.
model LoggedMeal {
  id     String           @id @default(cuid())
  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String
  name   String
  slot   MealSlot
  source LoggedMealSource @default(MANUAL)

  loggedAt DateTime @default(now())

  // Always the sum of `items` at write time (§6) - ingredients are the source
  // of truth; this is a render cache, never an independently authored number.
  caloriesKcal Float
  // Nullable like fiberG (Chunk 5b): a meal made entirely of estimated-dish
  // items (§7.6.1) has no known macro totals at all - unknown, not zero.
  proteinG     Float?
  carbsG       Float?
  fatG         Float?
  fiberG       Float?

  // Which catalog/nutrition-engine version produced the numbers above (§12.3,
  // Chunk 8a) - stamped once at write time, never re-derived, so a later
  // catalog correction can't retroactively reinterpret what this meal's
  // numbers "really" were. `catalogVersion` comes from the global
  // `CatalogVersion` singleton at confirm time; `nutritionEngineVersion` from
  // `settings.NUTRITION_ENGINE_VERSION`.
  catalogVersion         Int @default(1)
  nutritionEngineVersion Int @default(1)

  items LoggedMealItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, loggedAt])
}

model LoggedMealItem {
  id     String      @id @default(cuid())
  meal   LoggedMeal  @relation(fields: [mealId], references: [id], onDelete: Cascade)
  mealId String
  // Nullable (Chunk 5b) - null iff this is an estimated-dish row
  // (`dishCategory != null`), which has no Food relation at all.
  food   Food?       @relation(fields: [foodId], references: [id])
  foodId String?

  // Only populated for an estimated-dish row - a resolved row's display name
  // still comes from food.name, exactly as before this chunk.
  rawText String?

  // Always populated (unlike MealDraftItem's nullable version) - an
  // estimated dish always resolves to a concrete serving (stated, or the
  // §7.6.1 default) by the time it reaches a LoggedMealItem row; there is no
  // UNRESOLVED-shaped row in this model to leave them null for.
  quantity Float
  unit     String    // "g", "katori", "piece"...
  // Resolved mass FROM `quantity`+`unit`, in `state` (as entered) - what the
  // item shows the user, not a defaultState-basis figure. Any raw<->cooked
  // conversion needed to reach the food's own basis happens at write time via
  // nutrition.calculator.apply_yield and is reflected only in the nutrition
  // columns below, so this always matches what the person actually said.
  grams    Float
  state    FoodState @default(UNSPECIFIED)

  // Computed once at write time (§8) and never re-derived silently, so a
  // later catalog edit can't retroactively rewrite a past meal (full
  // snapshot/versioning is a later chunk - §12.3). For a resolved item, from
  // food.*Per100g x grams/100; for an estimated dish, from the current
  // DishCategoryProfile (§7.6.1) - either way, recomputed fresh at confirm,
  // never carried over from the draft's own numbers (§12.5).
  caloriesKcal Float
  // Null for an estimated dish - macros unknown, not zero (§7.6.1).
  proteinG     Float?
  carbsG       Float?
  fatG         Float?
  fiberG       Float?

  // ESTIMATED_DISH persistence (§7.6.1) - kept in the frozen snapshot
  // (§12.3) so a meal's history view shows the same range it did at log
  // time, not just the midpoint that counted toward totals.
  dishCategory   String?
  kcalLow        Float?
  kcalHigh       Float?
  profileVersion Int?

  createdAt DateTime @default(now())
}

// --- Meal Assistant chat drafts (AI Meal Assistant PRD §9, §12.1, §12.2) ---
//
// Chunk 2a: the draft data model, state machine, optimistic locking, and
// confirm-time idempotency - built and tested against structured input
// identical in shape to Chunk 1's manual entry.
// Chunk 2b (this addition): free-text understanding on top of it - the
// T-1/T0/T1 pipeline, ChatMessage, and food-name matching. Still no AI/LLM
// (that's Chunk 4+) and no composite dishes (Chunk 3) or estimated-dish
// handling (Chunk 5).

enum DraftStatus {
  OPEN
  CONFIRMED
  DISCARDED
  EXPIRED
}

/// Which tier produced a draft/message (§9). `MANUAL` is NOT in the PRD's
/// enum - it's added here because none of the PRD's members describe "no
/// parsing happened," which is the only case Chunk 2a's structured endpoints
/// produce. Chunk 2b makes PRECLASSIFIER/CACHE/PARSER reachable; Chunk 4 adds
/// LLM_SMALL/LLM_LARGE.
enum ParseTier {
  MANUAL
  PRECLASSIFIER
  CACHE
  PARSER
  LLM_SMALL
  LLM_LARGE
}

/// An item is in exactly one resolution state, and that state determines
/// which fields are required/meaningful (enforced in the service layer, not
/// the database). RESOLVED and UNRESOLVED are both reachable from Chunk 2b
/// (a low/no-confidence food-name match resolves to UNRESOLVED); ESTIMATED_DISH
/// needs the AI-driven DishCategoryProfile (Chunk 5).
enum ItemResolution {
  RESOLVED
  UNRESOLVED
  ESTIMATED_DISH
}

/// Was an amount stated? (§5.1.1a) Only EXPLICIT is reachable through
/// Chunk 2b - both the structured item endpoint and the T1 grammar require an
/// explicit quantity. ASSUMED needs the quantity-resolution ladder (Chunk 4).
enum QuantitySource {
  EXPLICIT
  ASSUMED
}

/// How a quantity was converted to grams (§5.1.1a). Only DIRECT and
/// HOUSEHOLD_TABLE are reachable through Chunk 2b - USER_HISTORY/
/// CATALOG_SERVING/CATEGORY_FALLBACK are ladder steps that need Chunk 4.
enum MassSource {
  DIRECT
  HOUSEHOLD_TABLE
  USER_HISTORY
  CATALOG_SERVING
  CATEGORY_FALLBACK
}

/// Food-resolution confidence band (§12.6). Null for Chunk 2a's
/// exact-id-chosen items (nothing to band); populated by Chunk 2b's fuzzy
/// food-name matching.
enum MatchBand {
  HIGH
  MEDIUM
  LOW
}

/// Groups a user's drafts and chat messages. Not client-visible yet -
/// get-or-created internally, one per UTC calendar day per user (see
/// assistant.repository.get_or_create_today_session). Becomes a real
/// "resume my chat" concept once a scrollback UI reads `messages` (Chunk 6+).
model ChatSession {
  id        String        @id @default(cuid())
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  startedAt DateTime      @default(now())
  drafts    MealDraft[]
  messages  ChatMessage[]
  // Set once a WELLBEING_FLAG response fires in this session (§5.6: "never
  // gamify in this state - suppress streak celebrations and deficit-praise
  // copy for the session"). Forward-declared - no gamification/streak
  // feature reads this yet, same posture as ParseTier.MANUAL.
  gamificationSuppressed Boolean @default(false)

  @@index([userId, startedAt])
}

/// A live, editable, server-side draft (§5.1.1, §9) - the object every chat
/// mutation (tap or, from Chunk 2b, text) mutates in place rather than
/// re-creating.
model MealDraft {
  id        String      @id @default(cuid())
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId String
  name      String
  slot      MealSlot
  items     MealDraftItem[]
  // Which chat messages rendered this draft as a preview card (the inverse of
  // ChatMessage.draftId, per the PRD §9 sketch) - unused by anything yet, but
  // required for the relation to compile.
  messages  ChatMessage[]
  operations DraftOperation[]

  // Always the sum of `items` at write time (§6) - recomputed on every
  // mutation exactly like LoggedMeal's totals, never authored independently.
  caloriesKcal Float
  // Nullable like fiberG (Chunk 5b): a draft made entirely of estimated-dish
  // items (§7.6.1) has no known macro totals at all - unknown, not zero.
  proteinG     Float?
  carbsG       Float?
  fatG         Float?
  fiberG       Float?

  parseTier  ParseTier @default(MANUAL)
  confidence Float     @default(1.0)

  // Optimistic lock (§12.1): increments on every mutation. A mutating request
  // carries the version it read; a mismatch means someone else changed the
  // draft first.
  version Int @default(1)

  status    DraftStatus @default(OPEN)
  // 24h TTL. Enforced by transactional lazy expiry at creation
  // (assistant.repository.create_draft_with_expiry_check) plus a read-path
  // check (assistant.repository.expire_draft_if_stale) - see §12.2. There is
  // NO database-level partial unique index backing "one open draft per user"
  // (Prisma's schema language can't express a WHERE-filtered unique
  // constraint without a raw-SQL migration, and this repo only uses
  // `db push` today) - enforcement is app-level only. Small race window on
  // concurrent multi-device draft creation, documented and accepted; revisit
  // if/when the team adopts `prisma migrate`.
  expiresAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
}

/// An item on an open draft. No nutrition columns here (unlike
/// LoggedMealItem): a draft is mutable and unconfirmed, so nutrition is
/// computed live from food.*Per100g x grams/100 on every read rather than
/// frozen - freezing only matters once a meal is actually logged (§12.3).
///
/// FIELD REQUIREMENTS BY RESOLUTION STATE (enforced in the service layer):
///   RESOLVED        foodId, quantity, unit, grams, defaultGrams,
///                    quantitySource, massSource                 REQUIRED
///                    matchScore/matchBand                        set when
///                                                                 food-name
///                                                                 matched
///                                                                 (Chunk 2b);
///                                                                 null for a
///                                                                 structured,
///                                                                 exact-id
///                                                                 pick (2a)
///                    dishCategory, kcal*                         MUST BE NULL
///   UNRESOLVED      rawText                                      REQUIRED
///                    everything else                             NULL
///   ESTIMATED_DISH  dishCategory, grams, kcalLow/High/Midpoint,
///                    profileVersion                              REQUIRED
///                    (unreachable until Chunk 5)
model MealDraftItem {
  id      String        @id @default(cuid())
  draft   MealDraft     @relation(fields: [draftId], references: [id], onDelete: Cascade)
  draftId String
  resolution ItemResolution @default(RESOLVED)

  food   Food?   @relation(fields: [foodId], references: [id])
  foodId String?
  // Always present. Synthesized ("200g Cooked White Rice") for a structured,
  // 2a-style item with no user-typed text; from Chunk 2b it's the actual
  // matched phrase, and for UNRESOLVED items it's what a low-confidence match
  // will file to the miss-queue (Chunk 3).
  rawText String

  quantity Float?
  unit     String?
  grams    Float?
  state    FoodState @default(UNSPECIFIED)
  // Baseline for Adjust Portion's multiplier chips and deltas (§5.2.1) - set
  // once at item creation to the item's own `grams`, then held fixed across
  // edits so "the default" stays meaningful.
  defaultGrams Float?

  // Full interpretation persisted, nothing dropped. `prep` is populated by
  // Chunk 2b's grammar (e.g. "grilled" alongside state=COOKED); `sizeQualifier`
  // stays null through Chunk 2b - the grammar doesn't attempt to detect it at
  // all yet, since acting on it needs the base-serving ladder (Chunk 4).
  prep          String?
  sizeQualifier String?

  quantitySource QuantitySource? // drives the est. chip (§5.1.1a) - always EXPLICIT through Chunk 2b
  massSource     MassSource?     // drives the provenance line

  matchScore Float?     // null for a structured, exact-id item (2a); set by Chunk 2b's fuzzy match
  matchBand  MatchBand?

  // ESTIMATED_DISH persistence (§7.6.1) - unreachable until Chunk 5.
  dishCategory   String?
  kcalLow        Float?
  kcalHigh       Float?
  kcalMidpoint   Float?
  profileVersion Int?

  createdAt DateTime @default(now())
}

/// Audit trail for every draft mutation (§12.2, Chunk 5a) - concurrency
/// debugging, a provenance trail for the eval set, and what makes Undo a
/// later feature rather than a rewrite. `op` deliberately has no CONFIRM/
/// DISCARD/EXPIRE value (matching the PRD's literal sketch) - those state
/// transitions stay auditable via MealDraft.status itself.
model DraftOperation {
  id      String    @id @default(cuid())
  draft   MealDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)
  draftId String
  op      String // CREATE | EDIT_ITEM | ADD_ITEM | REMOVE_ITEM | SET_SLOT | RENAME
  // Always "user" today - no scheduled sweeper or other system-initiated
  // mutation exists in this codebase yet. Reserved for when one does, same
  // forward-declared-but-unused posture as ParseTier.MANUAL.
  actor   String
  payload Json
  version Int // resulting draft version
  createdAt DateTime @default(now())

  @@index([draftId, version])
}

/// Idempotency for mutating requests that must never double-apply on retry
/// (§9, §12.1). Guards `confirm` (double-tapping Confirm & Log must not
/// create two LoggedMeals) and, from Chunk 2b, `POST /messages` (a retried
/// send must not double-parse or double-mutate the draft).
model IdempotencyRecord {
  key    String @id // client-supplied idempotency key
  userId String
  // Guards against the same key being reused with different request content -
  // a replay must match both the key AND the original request.
  requestHash  String
  responseBody Json
  statusCode   Int
  createdAt    DateTime @default(now())
  // 24h for now. RETENTION RULE (§9): once the offline queue exists (Chunk 7)
  // this must be >= the offline replay window, or a queued op replayed after
  // this expires creates a duplicate - exactly the bug the PRD's v1.6 review
  // caught. Revisit this constant then; it must not be tuned independently of
  // the queue's max age.
  expiresAt DateTime

  @@index([expiresAt])
}

// --- Chunk 2b: free-text understanding (AI Meal Assistant PRD §7, §9) ------

enum ChatRole {
  USER
  ASSISTANT
}

/// What a message resolved to (§9, §7.5). Only the 6 members Chunk 2b can
/// actually produce - the other 7 PRD intents (DIARY_QUERY, APP_HELP,
/// NUTRITION_QA, ADVICE_SEEKING, WELLBEING_FLAG, SOCIAL, UNCLEAR) arrive with
/// the full 13-intent taxonomy in Chunk 6. Until then, anything the T-1 gate
/// doesn't recognise as food-parsing-shaped is tagged OTHER.
/// The PRD's full 13-intent taxonomy (§5.5, §5.6).
enum ChatIntent {
  LOG_NEW
  EDIT_ITEM
  ADD_ITEM
  REMOVE_ITEM
  SET_SLOT
  DIARY_QUERY
  APP_HELP
  NUTRITION_QA
  ADVICE_SEEKING
  WELLBEING_FLAG
  SOCIAL
  UNCLEAR
  OTHER
}

/// One turn of the chat (§9). `content` is the raw text for USER messages and
/// the scripted reply for ASSISTANT ones. `userId` is denormalized off
/// `session` purely so the T0 cache lookup (`assistant.repository.
/// find_cached_message`) doesn't need a join.
model ChatMessage {
  id      String      @id @default(cuid())
  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId String
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId  String

  role            ChatRole
  // Idempotency key (§12.1) - null for ASSISTANT rows, which are never
  // retried independently of the USER message that produced them.
  clientMessageId String?
  content         String

  // T0 cache key (§7.4) - hash(normalize(content)); null for ASSISTANT rows
  // and for USER rows that never attempt a food parse (e.g. a caught
  // greeting has nothing worth caching).
  normalizedHash String?
  tier           ParseTier?
  intent         ChatIntent?
  // Which draft this message rendered as a preview card, if any (§9).
  draftId String?
  draft   MealDraft? @relation(fields: [draftId], references: [id])
  // The resolved *input* items for a successful LOG_NEW - {name, slot, items:
  // [{foodId, quantity, unit, state}]} - reused by a T0 hit instead of
  // re-running the grammar. Deliberately not pre-computed nutrition: a T0 hit
  // re-resolves through the same food-catalog lookup every other path uses,
  // so it can never go stale against a catalog edit. Null for everything else.
  parseSnapshot Json?

  createdAt DateTime @default(now())

  // Correlation chain (§12.9, Chunk 8b) - see ParseEvent.requestId.
  requestId String?

  @@unique([sessionId, clientMessageId])
  @@index([userId, normalizedHash])
  @@index([requestId])
}

// --- Chunk 3: composite foods & miss-queue flywheel (AI Meal Assistant PRD §7.6, §9, I8) ---
//
// A named dish ("chicken biryani") is several foods in fixed proportions, not a
// single catalog row. §7.6: decomposing it is "a catalog lookup, not a language
// task" - it must never vary run to run, so it's matched and expanded here with
// no model call, same as everything else through this chunk. `FoodMissQueue`
// turns every food (or dish) name the catalog can't resolve into curation
// backlog instead of a silently-dropped signal.

/// A curated dish -> its components, in fixed as-served proportions (§7.6).
/// Matched by an EXACT, normalized lookup against `name`/`aliases`
/// (assistant.services._resolve_composite_by_name) - deliberately not the
/// fuzzy partial-ratio scorer individual foods use, because a single word
/// that's genuinely part of a composite's name ("dal" in "Dal Chawal") scores
/// a perfect partial-ratio match and would wrongly swallow a plain mention of
/// the standalone food. A curator adds real shorthand as an alias instead.
model CompositeFood {
  id      String  @id @default(cuid())
  name    String
  aliases String[]
  // Not filtered on yet - no per-user locale context exists in the pipeline.
  locale  String?

  // Components are defined against ONE serving of this as-served size.
  servingGrams Float
  servingLabel String // "1 plate", "1 katori"

  // Same machinery as Food.embedding above (§7.6: composite matching by
  // "trigram + embedding, same machinery as food resolution"). Embedded from
  // name + aliases, since a curator's shorthand is exactly what a user types.
  embedding      Unsupported("vector(1536)")?
  embeddingModel String?
  embeddedAt     DateTime?

  components CompositeFoodComponent[]
  isCurated  Boolean @default(false)
  // Declared for §12.7's future cache-key versioning; unused until Chunk 8,
  // same forward-declared pattern as Chunk 2a's MANUAL ParseTier.
  catalogVersion Int @default(1)

  @@index([name])
}

/// One food's share of a composite dish (§7.6). `ratioOfServing` values for a
/// dish sum to ~1.0 as-served; that invariant is enforced at curation time
/// (seed/curation tooling), not at runtime. No `yieldFactor` here, deliberately
/// (PRD v1.5 fix): raw<->cooked conversion happens once, via the per-food
/// yield table, when `state` differs from the component's food's own
/// `defaultState` - carrying a second runtime factor here is how
/// double-application bugs happen.
model CompositeFoodComponent {
  id          String        @id @default(cuid())
  composite   CompositeFood @relation(fields: [compositeId], references: [id], onDelete: Cascade)
  compositeId String
  food        Food          @relation(fields: [foodId], references: [id])
  foodId      String

  ratioOfServing Float
  // Raw or cooked basis for THIS component as curated - e.g. a component
  // curated RAW against a food whose defaultState is COOKED still needs
  // yield conversion at expansion time (assistant.services._expand_composite
  // reuses meals.services.resolve_item for exactly this).
  state      FoodState @default(UNSPECIFIED)
  prep       String?
  isOptional Boolean   @default(false)
}

/// Curation backlog (§9, I8) - every food or dish name the catalog can't
/// resolve, from any entry point (chat's unresolved items, and a manual
/// catalog search that comes up empty). No curation workflow/UI is built
/// here; a human works this via `manage.py`/direct DB access - the row
/// existing is the whole deliverable.
model FoodMissQueue {
  id          String   @id @default(cuid())
  rawText     String
  occurrences Int      @default(1)
  // NOT nullable, deliberately (PRD shows `locale String?`): Postgres unique
  // indexes treat every NULL as distinct from every other NULL, so
  // `@@unique([rawText, locale])` would silently fail to dedupe repeated
  // misses with no locale - every upsert would insert a fresh row instead of
  // incrementing `occurrences`, defeating the point of this model. Empty
  // string stands in for "no locale" so the uniqueness check actually holds.
  locale      String   @default("")
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())

  @@unique([rawText, locale])
}

// --- Chunk 4a: AI intent layer telemetry (AI Meal Assistant PRD §7.3, §9, I9) --
//
// The small model handles descriptive input T1's grammar can't parse (§7.1).
// Cost & quality telemetry are first-class from the moment a model call can
// happen at all, not an afterthought (I9) - logged here for every T2 call.

/// One model call's cost/quality record (§9). Logged only for T2/T3 calls in
/// Chunk 4a/4b, not retroactively for T-1/T0/T1 (which already work and cost
/// nothing) - a deliberate, narrower reading of "from day one" than
/// instrumenting every tier that predates this chunk.
model ParseEvent {
  id             String     @id @default(cuid())
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  inputHash      String
  tier           ParseTier
  intent         ChatIntent
  // True only for the T2 (or T2->T3, once per message - see AiQuotaCounter)
  // call that actually consumed a unit of AI quota (Chunk 4c); false for
  // edits, non-food messages, cache hits, and a T3 call that piggybacks on
  // a message's already-consumed quota.
  countedToQuota Boolean    @default(false)
  model          String?
  promptTokens   Int?
  outputTokens   Int?
  costMicros     Int?
  latencyMs      Int
  confidence     Float
  // Not updated by anything through Chunk 4b - populating these needs
  // tracking a pre-confirm edit and a completed confirm, which is a later
  // observability pass. Documented gap, not a silent one.
  wasCorrected   Boolean    @default(false)
  wasLogged      Boolean    @default(false)
  createdAt      DateTime   @default(now())

  // Correlation chain (§12.9, Chunk 8b) - the HTTP request that triggered
  // this call, from `common.middleware.RequestIdMiddleware`. Null when there
  // was no request in flight (e.g. a management command, or a service
  // function called directly in a test).
  requestId String?

  @@index([inputHash])
  @@index([userId, createdAt])
  @@index([requestId])
}

/// Per-user portion learning - the quantity-resolution ladder's step 1 and
/// the feature's self-improvement loop (§5.1.1a): after a few weeks, a bare
/// food mention resolves to *this user's* usual portion instead of a generic
/// default. `recentGrams` is the actual observation history (oldest first,
/// capped at 10 on write) so `medianGrams`/`observations` are a literal
/// median-of-recent-logs, not an approximation with no underlying data.
model UserServingPreference {
  id           String    @id @default(cuid())
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  food         Food      @relation(fields: [foodId], references: [id], onDelete: Cascade)
  foodId       String
  // Raw vs. cooked rice are different portions - keyed in, same reasoning as
  // everywhere else `FoodState` appears on a draft item.
  state        FoodState @default(UNSPECIFIED)
  recentGrams  Float[]   @default([])
  medianGrams  Float     @default(0)
  observations Int       @default(0)
  updatedAt    DateTime  @updatedAt

  // Deliberately narrower than the PRD's `(userId, foodId, state, unit)` key -
  // see the Chunk 4b plan for why `unit` is dropped (the ladder only ever
  // fires when no unit was stated, so there's nothing to match it against)
  // and why the PRD's coarser `(userId, foodId)`-only fallback below 3
  // observations is not implemented (it reintroduces the raw/cooked
  // conflation §16.6 flagged as a bug).
  @@unique([userId, foodId, state])
}

/// AI-parse quota (§5.1.4, §12.8) - a semi-rolling 24h window, reset on first
/// use after expiry rather than a true sliding log of individual events.
/// Deliberate simplification, same posture as `MealDraft`'s app-level
/// one-open-draft check: no Redis in this stack, so the "locked-row counter"
/// the PRD offers as the alternative is a conditional `UPDATE ... WHERE` -
/// Postgres locks the row it's about to modify even under READ COMMITTED, so
/// two concurrent requests serialize on it without raw SQL or a `FOR UPDATE`
/// select (see assistant.repository.try_consume_quota).
model AiQuotaCounter {
  id          String   @id @default(cuid())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String   @unique
  windowStart DateTime
  count       Int      @default(0)
  updatedAt   DateTime @updatedAt
}

// Cost circuit breaker (§11, §12.8's third mechanism, Chunk 8d) - one global
// row, id="global". Trips on repeated *transient* LLM call failures, never a
// config error (a missing API key fails identically forever - a cooldown
// can't fix it). While open, `_call_llm` skips the call outright and falls
// back to the existing graceful degraded response, so chat is never fully
// unavailable during a real outage (§11) and doesn't pay a timeout on every
// request. Deliberately failure-based only - a cost-spike trigger needs a
// real $ budget number this codebase has nothing to calibrate against yet;
// documented gap, not silently dropped.
model AiCircuitBreaker {
  id                  String    @id @default("global")
  consecutiveFailures Int       @default(0)
  // Null = closed/healthy. Set = tripped at this timestamp; a fresh failure
  // on the first post-cooldown probe call re-sets it to now, extending the
  // cooldown rather than leaving the stale timestamp in place.
  openedAt            DateTime?
  updatedAt           DateTime  @updatedAt
}

/// L2 cache (§7.4) - normalized-hash -> resolved `LOG_NEW` parse, shared
/// across every user so a common phrasing only ever needs one paid model
/// call. No `userId`: global and PII-free by construction (the key is a hash
/// of normalized food text, never the raw message or anything user-specific).
/// `snapshot` is the identical shape `ChatMessage.parseSnapshot` already
/// uses. Catalog-version invalidation (§7.4, §12.7) is a documented gap here,
/// same as `CompositeFood.catalogVersion`'s forward-declared-but-unused field.
model GlobalParseCache {
  id             String   @id @default(cuid())
  normalizedHash String   @unique
  snapshot       Json
  hitCount       Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}
