// CaloryX — onboarding data model.
// PRD §7. Extended with Clerk identity, guest claiming, and server-side engine config (§10).

generator client {
  provider             = "prisma-client-py"
  interface            = "sync"
  recursive_type_depth = 5
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SexAtBirth {
  MALE
  FEMALE
  UNSPECIFIED // defensive-only value (§6.4); onboarding v7 never writes it
}

enum Goal {
  LOSE
  MAINTAIN
  GAIN
}

enum ActivityLevel {
  SEDENTARY
  LIGHT
  MODERATE
  VERY
  EXTREME
}

/// DEPRECATED - superseded by WeightUnit + HeightUnit, which can express the
/// mixed choices (kg + ft/in, lb + cm) a single system cannot. Kept only until
/// `backfill_unit_preferences` has run everywhere; drop with the column.
enum UnitSystem {
  METRIC
  IMPERIAL
}

/// Display units (§5.2). Values are always stored metric; these record only how
/// the client renders them. Weight covers current and target weight alike.
enum WeightUnit {
  KG
  LB
}

enum HeightUnit {
  CM
  FT_IN
}

enum AuthProvider {
  GUEST
  CLERK
}

model User {
  id           String       @id @default(cuid())
  // Clerk owns Google / Apple / any future provider on the client. We store the
  // stable Clerk user id; the underlying provider is recorded for analytics only.
  clerkUserId  String?      @unique
  authProvider AuthProvider @default(GUEST)
  // Which social provider Clerk used ("oauth_google", "oauth_apple", ...). Nullable
  // for guests. Apple private-relay addresses land in `email` unchanged.
  externalProvider String?
  email        String?
  isGuest      Boolean      @default(true)
  // Set when a guest record is merged into a Clerk identity (§5.1 claiming).
  claimedAt    DateTime?
  claimedFrom  String?      @unique
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  lastSeenAt   DateTime     @default(now())
  profile      Profile?
  loggedMeals  LoggedMeal[]
  chatSessions ChatSession[]
  mealDrafts   MealDraft[]

  @@index([isGuest, createdAt])
}

model Profile {
  id             String        @id @default(cuid())
  userId         String        @unique
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  sexAtBirth     SexAtBirth // onboarding v7 writes MALE or FEMALE
  /// The user's date of birth (§9). Age is derived from this on every read and
  /// never stored, so it advances with the calendar instead of freezing at
  /// signup. A pure date: only ever used for year arithmetic.
  dateOfBirth    DateTime?     @db.Date
  // DEPRECATED - read only by `backfill_date_of_birth`; drop once it has run.
  age            Int
  weightKg       Float // stored metric; imperial is a display concern (§5.2)
  heightCm       Float
  targetWeightKg Float?
  goal           Goal
  activityLevel  ActivityLevel
  weightUnit     WeightUnit    @default(KG)
  heightUnit     HeightUnit    @default(CM)
  // DEPRECATED - read only by `backfill_unit_preferences`; drop once it has run.
  preferredUnits UnitSystem    @default(METRIC)
  onboardedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  plan           Plan?
}

model Plan {
  id           String   @id @default(cuid())
  profileId    String   @unique
  profile      Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  caloriesKcal Int
  proteinG     Int
  carbsG       Int
  fatG         Int
  fiberG       Int // informational; never part of the energy total (§5.5)
  bmr          Float
  tdee         Float
  clamped      Boolean  @default(false)
  isEstimate   Boolean  @default(false) // true only via the §6.4 defensive fallback
  // Rationale derives from the *effective* adjustment, which differs from the
  // configured one whenever the safety floor clamps the target (§6.2).
  adjustmentKcal Int
  weeklyChangeKg Float
  // The §6.2 floor that produced this target and the goal adjustment it overrode,
  // so a resumed plan explains itself without re-deriving from a config that may
  // since have been retuned. Nullable only for rows written before these columns
  // existed; `manage.py backfill_plan_rationale` clears them.
  safetyFloorKcal         Int?
  requestedAdjustmentKcal Int?
  // Which config produced these numbers, so a plan stays explainable after a retune.
  engineConfigId String?
  engineConfig   EngineConfig? @relation(fields: [engineConfigId], references: [id])
  computedAt     DateTime      @default(now())
}

/// Server-configurable engine constants (§5.3, §5.4, §6.3, §10). Exactly one row
/// should have isActive = true; code falls back to compiled defaults if none does.
model EngineConfig {
  id       String  @id @default(cuid())
  name     String  @unique
  isActive Boolean @default(false)

  // Goal adjustments (kcal)
  loseAdjustmentKcal Int @default(-400)
  gainAdjustmentKcal Int @default(400)

  /// Half-width of the MAINTAIN band, kg. A target within this of the current
  /// weight derives MAINTAIN; outside it the sign of the difference picks LOSE
  /// or GAIN. The goal is derived rather than asked for (§5.3), so this is the
  /// threshold that decides which adjustment above a user gets.
  maintainBandKg Float @default(1.0)

  // Activity multipliers
  sedentaryMultiplier Float @default(1.2)
  lightMultiplier     Float @default(1.375)
  moderateMultiplier  Float @default(1.55)
  veryMultiplier      Float @default(1.725)
  extremeMultiplier   Float @default(1.9)

  // Macro ratios
  proteinPerKg      Float @default(1.8)
  fatPct            Float @default(0.25)
  fiberGPer1000Kcal Float @default(15.0)

  // Safety floors (§6.2)
  floorMaleKcal        Int @default(1500)
  floorFemaleKcal      Int @default(1200)
  floorUnspecifiedKcal Int @default(1500)

  // Rounding + rationale
  targetRoundingKcal Int   @default(10)
  kcalPerKgBodyMass  Float @default(7700.0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  plans     Plan[]

  @@index([isActive])
}

// --- Meal logging (AI Meal Assistant PRD §6, §8) ---------------------------
//
// Chunk 1 of the roadmap: the deterministic foundation every later chunk
// (chat drafts, AI parsing, composite foods, ...) builds on. No chat, no AI -
// just a Food catalog and the ability to log a fully-quantified meal against
// it, with the same nutrition math every later tier will call into.

enum FoodSource {
  USDA
  OPEN_FOOD_FACTS
  CALORYX_CURATED
}

/// Raw vs. cooked - the single largest accuracy risk in text-based logging
/// (§8: rice roughly triples in mass when cooked). UNSPECIFIED means the
/// distinction was never captured, not that the food has none.
enum FoodState {
  RAW
  COOKED
  UNSPECIFIED
}

enum ServingUnitType {
  CONTINUOUS
  COUNTABLE
  HOUSEHOLD
}

enum MealSlot {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

/// Distinguishes how a `LoggedMeal` was created (§6 "parity with the Meals
/// surface") without implying a different record shape. CHAT_AI is unused
/// until the chat pipeline (Chunk 2+) starts writing here.
enum LoggedMealSource {
  MANUAL
  CHAT_AI
}

/// Food catalog (§8). Nutrient columns are per 100g, on `defaultState` basis -
/// e.g. rice defaults to COOKED, so its vector describes cooked rice, and a
/// raw-stated quantity is converted via `rawToCookedYield` before lookup
/// (see nutrition.calculator.apply_yield).
model Food {
  id     String     @id @default(cuid())
  name   String
  source FoodSource
  // External id/name at the source - USDA FDC id, Open Food Facts barcode, or
  // a curation note. Nullable for CALORYX_CURATED entries with no upstream ref.
  sourceRef        String?
  defaultState     FoodState @default(UNSPECIFIED)
  // Grams-cooked-per-gram-raw. Null when the food has no meaningful raw/cooked
  // distinction (a banana) or the factor isn't catalogued yet - logging this
  // food in the non-default state then fails validation rather than guessing.
  rawToCookedYield Float?

  caloriesKcalPer100g Float
  proteinGPer100g     Float
  carbsGPer100g       Float
  fatGPer100g         Float
  // Missing != zero (§8): null means unknown and renders as "-"; it must never
  // be coerced to 0, or a partial macro sum silently understates.
  fiberGPer100g        Float?
  sugarGPer100g        Float?
  saturatedFatGPer100g Float?
  sodiumMgPer100g      Float?
  cholesterolMgPer100g Float?

  servingUnits    FoodServingUnit[]
  loggedMealItems LoggedMealItem[]
  mealDraftItems  MealDraftItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
}

/// Household/countable measures, defined per food (§8) - a cup of rice and a
/// cup of spinach are not the same mass. `g`/`kg` are universal and never
/// stored here; see nutrition.units.resolve_grams.
model FoodServingUnit {
  id     String @id @default(cuid())
  food   Food   @relation(fields: [foodId], references: [id], onDelete: Cascade)
  foodId String
  unit   String // "katori", "cup", "roti", "piece"...
  grams  Float  // grams per one `unit`, as-served
  type   ServingUnitType

  @@unique([foodId, unit])
}

/// A logged meal (§6). Whatever surface creates it (this chunk's direct entry,
/// or a chat draft later), it lands here as the same record - `source` is the
/// only thing that varies.
model LoggedMeal {
  id     String           @id @default(cuid())
  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String
  name   String
  slot   MealSlot
  source LoggedMealSource @default(MANUAL)

  loggedAt DateTime @default(now())

  // Always the sum of `items` at write time (§6) - ingredients are the source
  // of truth; this is a render cache, never an independently authored number.
  caloriesKcal Float
  proteinG     Float
  carbsG       Float
  fatG         Float
  fiberG       Float?

  items LoggedMealItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, loggedAt])
}

model LoggedMealItem {
  id     String     @id @default(cuid())
  meal   LoggedMeal @relation(fields: [mealId], references: [id], onDelete: Cascade)
  mealId String
  food   Food       @relation(fields: [foodId], references: [id])
  foodId String

  quantity Float     // as entered, in `unit`
  unit     String    // "g", "katori", "piece"...
  // Resolved mass FROM `quantity`+`unit`, in `state` (as entered) - what the
  // item shows the user, not a defaultState-basis figure. Any raw<->cooked
  // conversion needed to reach the food's own basis happens at write time via
  // nutrition.calculator.apply_yield and is reflected only in the nutrition
  // columns below, so this always matches what the person actually said.
  grams    Float
  state    FoodState @default(UNSPECIFIED)

  // Computed once at write time from food.*Per100g x grams/100 (§8) and never
  // re-derived silently, so a later catalog edit can't retroactively rewrite a
  // past meal (full snapshot/versioning is a later chunk - §12.3).
  caloriesKcal Float
  proteinG     Float
  carbsG       Float
  fatG         Float
  fiberG       Float?

  createdAt DateTime @default(now())
}

// --- Meal Assistant chat drafts (AI Meal Assistant PRD §9, §12.1, §12.2) ---
//
// Chunk 2a of the roadmap: the draft data model, state machine, optimistic
// locking, and confirm-time idempotency - built and tested against structured
// input identical in shape to Chunk 1's manual entry. No free-text parsing,
// no ChatMessage, no AI: that's Chunk 2b, layered on top of what's here.

enum DraftStatus {
  OPEN
  CONFIRMED
  DISCARDED
  EXPIRED
}

/// Which tier produced a draft (§9). `MANUAL` is NOT in the PRD's enum - it's
/// added here because none of the PRD's members describe "no parsing
/// happened," which is the only case Chunk 2a's structured endpoints produce.
/// The rest become reachable starting Chunk 2b (PARSER, CACHE, PRECLASSIFIER
/// don't apply to a draft itself but round out the shared vocabulary) and
/// Chunk 4 (LLM_SMALL/LLM_LARGE).
enum ParseTier {
  MANUAL
  PRECLASSIFIER
  CACHE
  PARSER
  LLM_SMALL
  LLM_LARGE
}

/// An item is in exactly one resolution state, and that state determines
/// which fields are required/meaningful (enforced in the service layer, not
/// the database). Only RESOLVED is reachable in Chunk 2a - UNRESOLVED needs
/// food-name matching (Chunk 2b) and ESTIMATED_DISH needs the AI-driven
/// DishCategoryProfile (Chunk 5).
enum ItemResolution {
  RESOLVED
  UNRESOLVED
  ESTIMATED_DISH
}

/// Was an amount stated? (§5.1.1a) Only EXPLICIT is reachable in Chunk 2a -
/// the structured item endpoint requires a quantity. ASSUMED needs the
/// quantity-resolution ladder (Chunk 4).
enum QuantitySource {
  EXPLICIT
  ASSUMED
}

/// How a quantity was converted to grams (§5.1.1a). Only DIRECT and
/// HOUSEHOLD_TABLE are reachable in Chunk 2a - USER_HISTORY/CATALOG_SERVING/
/// CATEGORY_FALLBACK are ladder steps that need Chunk 4.
enum MassSource {
  DIRECT
  HOUSEHOLD_TABLE
  USER_HISTORY
  CATALOG_SERVING
  CATEGORY_FALLBACK
}

/// Food-resolution confidence band (§12.6). Unused (null) in Chunk 2a - a
/// draft item's food is chosen by exact id, not fuzzy-matched, so there is
/// nothing to band yet. Populated starting Chunk 2b.
enum MatchBand {
  HIGH
  MEDIUM
  LOW
}

/// Groups a user's drafts (and, from Chunk 2b, their chat messages). Not
/// client-visible yet - get-or-created internally, one per UTC calendar day
/// per user (see assistant.repository.get_or_create_today_session). Becomes a
/// real "resume my chat" concept once ChatMessage exists.
model ChatSession {
  id        String      @id @default(cuid())
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  startedAt DateTime    @default(now())
  drafts    MealDraft[]

  @@index([userId, startedAt])
}

/// A live, editable, server-side draft (§5.1.1, §9) - the object every chat
/// mutation (tap or, from Chunk 2b, text) mutates in place rather than
/// re-creating.
model MealDraft {
  id        String      @id @default(cuid())
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId String
  name      String
  slot      MealSlot
  items     MealDraftItem[]

  // Always the sum of `items` at write time (§6) - recomputed on every
  // mutation exactly like LoggedMeal's totals, never authored independently.
  caloriesKcal Float
  proteinG     Float
  carbsG       Float
  fatG         Float
  fiberG       Float?

  parseTier  ParseTier @default(MANUAL)
  confidence Float     @default(1.0)

  // Optimistic lock (§12.1): increments on every mutation. A mutating request
  // carries the version it read; a mismatch means someone else changed the
  // draft first.
  version Int @default(1)

  status    DraftStatus @default(OPEN)
  // 24h TTL. Enforced by transactional lazy expiry at creation
  // (assistant.repository.create_draft_with_expiry_check) plus a read-path
  // check (assistant.repository.expire_draft_if_stale) - see §12.2. There is
  // NO database-level partial unique index backing "one open draft per user"
  // (Prisma's schema language can't express a WHERE-filtered unique
  // constraint without a raw-SQL migration, and this repo only uses
  // `db push` today) - enforcement is app-level only. Small race window on
  // concurrent multi-device draft creation, documented and accepted; revisit
  // if/when the team adopts `prisma migrate`.
  expiresAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
}

/// An item on an open draft. No nutrition columns here (unlike
/// LoggedMealItem): a draft is mutable and unconfirmed, so nutrition is
/// computed live from food.*Per100g x grams/100 on every read rather than
/// frozen - freezing only matters once a meal is actually logged (§12.3).
///
/// FIELD REQUIREMENTS BY RESOLUTION STATE (enforced in the service layer):
///   RESOLVED        foodId, quantity, unit, grams, defaultGrams,
///                    quantitySource, massSource                 REQUIRED
///                    matchScore/matchBand                        set when
///                                                                 food-name
///                                                                 matched
///                                                                 (Chunk 2b)
///                    dishCategory, kcal*                         MUST BE NULL
///   UNRESOLVED      rawText                                      REQUIRED
///                    everything else                             NULL
///                    (unreachable until Chunk 2b)
///   ESTIMATED_DISH  dishCategory, grams, kcalLow/High/Midpoint,
///                    profileVersion                              REQUIRED
///                    (unreachable until Chunk 5)
model MealDraftItem {
  id      String        @id @default(cuid())
  draft   MealDraft     @relation(fields: [draftId], references: [id], onDelete: Cascade)
  draftId String
  resolution ItemResolution @default(RESOLVED)

  food   Food?   @relation(fields: [foodId], references: [id])
  foodId String?
  // Always present. In Chunk 2a there's no user-typed text to store, so this
  // is synthesized ("200g Cooked White Rice") for display/debug parity with
  // the PRD's shape; from Chunk 2b it's what the user actually said, and it's
  // what a low-confidence match files to the miss-queue (Chunk 3).
  rawText String

  quantity Float?
  unit     String?
  grams    Float?
  state    FoodState @default(UNSPECIFIED)
  // Baseline for Adjust Portion's multiplier chips and deltas (§5.2.1) - set
  // once at item creation to the item's own `grams`, then held fixed across
  // edits so "the default" stays meaningful.
  defaultGrams Float?

  // Full interpretation persisted, nothing dropped - always null in Chunk 2a,
  // no grammar exists yet to populate them (Chunk 2b).
  prep          String?
  sizeQualifier String?

  quantitySource QuantitySource? // drives the est. chip (§5.1.1a) - always EXPLICIT in Chunk 2a
  massSource     MassSource?     // drives the provenance line

  matchScore Float?     // null in Chunk 2a - food is chosen by exact id, not fuzzy-matched
  matchBand  MatchBand?

  // ESTIMATED_DISH persistence (§7.6.1) - unreachable until Chunk 5.
  dishCategory   String?
  kcalLow        Float?
  kcalHigh       Float?
  kcalMidpoint   Float?
  profileVersion Int?

  createdAt DateTime @default(now())
}

/// Idempotency for mutating requests that must never double-apply on retry
/// (§9, §12.1). Used only by `confirm` in Chunk 2a (double-tapping
/// Confirm & Log must not create two LoggedMeals); Chunk 2b reuses it for
/// `POST /messages`.
model IdempotencyRecord {
  key    String @id // client-supplied idempotency key
  userId String
  // Guards against the same key being reused with different request content -
  // a replay must match both the key AND the original request.
  requestHash  String
  responseBody Json
  statusCode   Int
  createdAt    DateTime @default(now())
  // 24h for now. RETENTION RULE (§9): once the offline queue exists (Chunk 7)
  // this must be >= the offline replay window, or a queued op replayed after
  // this expires creates a duplicate - exactly the bug the PRD's v1.6 review
  // caught. Revisit this constant then; it must not be tuned independently of
  // the queue's max age.
  expiresAt DateTime

  @@index([expiresAt])
}
