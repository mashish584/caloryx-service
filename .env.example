# --- Django ---------------------------------------------------------------
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
LOG_LEVEL=INFO

# --- Database -------------------------------------------------------------
# Prisma owns the schema; Django's ORM is not used.
DATABASE_URL=postgresql://caloryx:caloryx@localhost:5432/caloryx?schema=public

# --- Clerk ----------------------------------------------------------------
# The app signs in with Clerk on the device and sends the session JWT as a
# bearer token. Only the issuer is required; the JWKS URL is derived from it.
# Find the issuer in Clerk Dashboard -> API Keys -> "Frontend API" / JWKS URL.
CLERK_ISSUER=https://your-instance.clerk.accounts.dev
# CLERK_JWKS_URL=https://your-instance.clerk.accounts.dev/.well-known/jwks.json
# Set only if your Clerk JWT template defines an `aud` claim.
# CLERK_AUDIENCE=caloryx
CLERK_LEEWAY_SECONDS=30
CLERK_JWKS_CACHE_SECONDS=600

# --- OpenAI (Meal Assistant T2/T3) -----------------------------------------
# Required for the chat's T2 escalation (descriptive input T1's grammar can't
# parse) to work at all - without it, those messages fall back to
# "I couldn't work out what food that was" rather than erroring.
OPENAI_API_KEY=sk-...
# OPENAI_SMALL_MODEL=gpt-4o-mini
# OPENAI_LARGE_MODEL=gpt-4o
# OPENAI_MAX_TOKENS=300
# OPENAI_TIMEOUT_SECONDS=10
# AI_QUOTA_LIMIT=20
# AI_QUOTA_WINDOW_HOURS=24
# T3_ESCALATION_CONFIDENCE_THRESHOLD=0.5
# Off by default - placeholder scaffolding pending clinical review (§5.6).
# WELLBEING_CHECK_ALL_MESSAGES=false
# Per-call-site AI fallback kill switches, all off by default.
# AI_NEW_MEAL_FALLBACK_ENABLED=false
# AI_T3_ESCALATION_ENABLED=false
# T1 quantity-less second pass - both resolve via the local ladder, no model call
# PARSER_COUNT_ONLY_QUANTITY_ENABLED=true
# PARSER_BARE_FOOD_MENTION_ENABLED=false
# AI_EDIT_FALLBACK_ENABLED=false

# --- Embeddings (semantic resolution, §7.2/§7.6) ---------------------------
# Used by `manage.py backfill_food_embeddings`. EMBEDDING_DIMENSIONS must
# match the vector(N) width in prisma/schema.prisma - the backfill refuses to
# run if they disagree. SEMANTIC_RESOLUTION_ENABLED is Chunk 9b's kill switch
# and does nothing yet.
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSIONS=1536
# EMBEDDING_MAX_BATCH=256
# EMBEDDING_TIMEOUT_SECONDS=30
# SEMANTIC_RESOLUTION_ENABLED=false
# Similarity floors - uncalibrated, deliberately conservative. See
# documents/known-issues.md before changing either.
# SEMANTIC_MATCH_FLOOR=0.75
# SEMANTIC_COMPOSITE_FLOOR=0.85
# SEMANTIC_CANDIDATE_LIMIT=25
# SEMANTIC_COMPOSITE_CANDIDATE_LIMIT=10

# --- Offline queue & sync --------------------------------------------------
# MAX_QUEUE_AGE_DAYS=30
# STALE_QUEUE_AGE_DAYS=7
# NUTRITION_DRIFT_EPSILON_KCAL=5

# --- Reproducibility & cache-key versioning --------------------------------
# NORMALIZATION_VERSION=1
# PARSER_VERSION=2
# NUTRITION_ENGINE_VERSION=1

# --- Privacy & retention ----------------------------------------------------
# CHAT_MESSAGE_RETENTION_DAYS=30

# --- Cost circuit breaker ---------------------------------------------------
# AI_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
# AI_CIRCUIT_BREAKER_COOLDOWN_SECONDS=60

# --- Guest sessions -------------------------------------------------------
GUEST_TOKEN_TTL_DAYS=180
GUEST_TOKEN_ISSUER=caloryx-service
GUEST_CREATE_RATE=20/hour

# --- CORS -----------------------------------------------------------------
# Native Expo requests send no Origin; this matters for web builds only.
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006

# --- Domain rules ---------------------------------------------------------
# PRD §9: 18 for v1, pending legal sign-off per launch market.
MINIMUM_AGE_YEARS=18
MAXIMUM_AGE_YEARS=100
