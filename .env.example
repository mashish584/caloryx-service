# --- Django ---------------------------------------------------------------
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
LOG_LEVEL=INFO

# --- Database -------------------------------------------------------------
# Prisma owns the schema; Django's ORM is not used.
DATABASE_URL=postgresql://caloryx:caloryx@localhost:5432/caloryx?schema=public

# --- Clerk ----------------------------------------------------------------
# The app signs in with Clerk on the device and sends the session JWT as a
# bearer token. Only the issuer is required; the JWKS URL is derived from it.
# Find the issuer in Clerk Dashboard -> API Keys -> "Frontend API" / JWKS URL.
CLERK_ISSUER=https://your-instance.clerk.accounts.dev
# CLERK_JWKS_URL=https://your-instance.clerk.accounts.dev/.well-known/jwks.json
# Set only if your Clerk JWT template defines an `aud` claim.
# CLERK_AUDIENCE=caloryx
CLERK_LEEWAY_SECONDS=30
CLERK_JWKS_CACHE_SECONDS=600

# --- Guest sessions -------------------------------------------------------
GUEST_TOKEN_TTL_DAYS=180
GUEST_TOKEN_ISSUER=caloryx-service
GUEST_CREATE_RATE=20/hour

# --- CORS -----------------------------------------------------------------
# Native Expo requests send no Origin; this matters for web builds only.
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006

# --- Domain rules ---------------------------------------------------------
# PRD §9: 18 for v1, pending legal sign-off per launch market.
MINIMUM_AGE_YEARS=18
MAXIMUM_AGE_YEARS=100
